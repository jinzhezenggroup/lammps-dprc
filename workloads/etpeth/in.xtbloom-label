# Publish one production xTBloom QM/MM force state and its MM-only reciprocal
# reference for a binary64 DPRc low-level label.  No dynamics, thermostat,
# umbrella restraint, or DPRc model contributes to either run-zero result.

clear
plugin load ${dprc_plugin}
units real
dimension 3
boundary p p p
atom_style full
atom_modify map array

read_data ${data_file}
reset_timestep 0
group qm id 1:16

bond_style harmonic
angle_style harmonic
pair_style hybrid/overlay lj/cut/dprc/batch 9.0 &
  tip4p/long/dprc/batch 6 7 1 1 0.125 9.0
include ${forcefield_file}
pair_coeff 6*7 6*7 tip4p/long/dprc/batch
pair_modify pair lj/cut/dprc/batch tail yes
special_bonds amber
kspace_style pppm/tip4p/dprc/batch 1.0e-6
kspace_modify mesh 50 50 50 order 4 gewald 0.348831617901729

# Capture the pre-fix force for diagnostics only; it already contains
# QM-dependent reciprocal forces. The zero-QM run supplies the true baseline.
fix pre_xtb all store/force
fix qmmm qm qmmm/xtb/dprc elements P O O C H O H cutoff 9.0 charge -2 &
  uhf 0 method gfn2 accuracy 0.001 maxiter 250 etemp 300.0 mmhardness 0.0 &
  kmax 8 8 8 ksqmax 100
fix_modify qmmm energy yes

neighbor 0.05 bin
neigh_modify every 1 delay 0 check yes
thermo 1
thermo_style custom step pe f_qmmm elong
thermo_modify format float %.17g lost error flush yes

run 0 post no
write_dump all custom ${dump_file} id type q xu yu zu fx fy fz &
  f_pre_xtb[1] f_pre_xtb[2] f_pre_xtb[3] &
  modify sort id format float %.17g
print "energy=$(pe:%.17g) correction=$(f_qmmm:%.17g) &
elong=$(elong:%.17g) pair_reference_mm_only=1 &
lx=$(lx:%.17g) ly=$(ly:%.17g) lz=$(lz:%.17g) &
xy=$(xy:%.17g) xz=$(xz:%.17g) yz=$(yz:%.17g)" &
  file ${result_file} screen no

# The fix energy is E_xTB + E_MM,KSpace - E_full,KSpace because the TIP4P
# pair sub-style is mapped only to MM/MM types.  Re-evaluating the reciprocal
# term with zero QM charges exposes E_MM,KSpace independently, allowing the
# publisher to reconstruct the raw xTBloom QM/MM energy without private C++
# implementation symbols.
unfix qmmm
unfix pre_xtb
set group qm charge 0.0
fix classical all dprc/classical/batch
thermo_style custom step pe elong
run 0 post no
print "mm_elong=$(elong:%.17g)" file ${mm_result_file} screen no
write_dump all custom ${mm_dump_file} id type q xu yu zu fx fy fz &
  modify sort id format float %.17g
