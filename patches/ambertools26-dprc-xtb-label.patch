 #endif


 contains

+  ! Read and freeze the exact GFN2-xTB settings used by the production
+  ! xTBloom path before the first force evaluation.  Keeping this guard
+  ! separate from the QUICK qualification prevents either low- or high-level
+  ! label mode from weakening the other's Hamiltonian contract.
+  logical function xtb_dprc_label_configuration_is_qualified()
+
+    implicit none
+
+#ifdef XTB
+    type(xtb_nml_type) :: candidate
+
+    call read_xtb_nml(candidate)
+    xtb_dprc_label_configuration_is_qualified = &
+         trim(candidate%qm_level) == 'GFN2-XTB' .and. &
+         abs(candidate%tfermi - 300.0d0) <= 1.0d-12 .and. &
+         abs(candidate%accuracy - 1.0d-3) <= 1.0d-15 .and. &
+         candidate%maxiter == 250 .and. &
+         abs(candidate%mmhardness) <= 1.0d-15 .and. &
+         .not. candidate%debug
+    if (.not. xtb_dprc_label_configuration_is_qualified) then
+       write(6,'(a,a,3(a,es24.16),a,i0,a,l1)') &
+            'Observed xTB qm_level=', trim(candidate%qm_level), &
+            ' tfermi=', candidate%tfermi, ' accuracy=', candidate%accuracy, &
+            ' mmhardness=', candidate%mmhardness, &
+            ' maxiter=', candidate%maxiter, ' debug=', candidate%debug
+    else if (xtb_qmmm_call_count == 0_int64) then
+       ! Avoid a time-of-check/time-of-use gap if the mdin file is replaced
+       ! between the runmd guard and newXTBIface's lazy initialization.
+       XTBstate%xtb_nml = candidate
+       xtb_nml_prevalidated = .true.
+    endif
+#else
+    xtb_dprc_label_configuration_is_qualified = .false.
+#endif
+
+  end function xtb_dprc_label_configuration_is_qualified
+

 #ifdef XTB

