 /* ----------------------------------------------------------------------
+   retain the MM-only reciprocal potential and fully communicated field
+------------------------------------------------------------------------- */
+
+template <class Solver> void QMMMXTBPPPMHelper<Solver>::cache_last_solve_as_mm(Solver &solver)
+{
+  if (solver.differentiation_flag != 0)
+    solver.error->all(FLERR, "Fused fix qmmm/xtb KSpace reuse requires ik PPPM");
+
+  solver.fused_mm_work1_.assign(solver.work1, solver.work1 + 2 * solver.nfft);
+  solver.fused_mm_field_.resize(static_cast<std::size_t>(3) * solver.ngrid);
+  const FFT_SCALAR *field[3] = {
+      &(solver.vdx_brick[solver.nzlo_out][solver.nylo_out][solver.nxlo_out]),
+      &(solver.vdy_brick[solver.nzlo_out][solver.nylo_out][solver.nxlo_out]),
+      &(solver.vdz_brick[solver.nzlo_out][solver.nylo_out][solver.nxlo_out])};
+  for (int dim = 0; dim < 3; ++dim)
+    std::copy(field[dim], field[dim] + solver.ngrid,
+              solver.fused_mm_field_.begin() + static_cast<std::size_t>(dim) * solver.ngrid);
+
+  solver.fused_mm_energy_ = solver.energy;
+  solver.fused_mm_qsum_ = solver.qsum;
+  for (int i = 0; i < 6; ++i) solver.fused_mm_virial_[i] = solver.virial[i];
+}
+
+/* ----------------------------------------------------------------------
+   combine the cached MM field with the just-computed QM-only field
+
+   PPPM is linear in charge density.  The field grids can therefore be added
+   directly.  The reciprocal energy and virial need the bilinear MM/QM term,
+   which is obtained from the two retained Green(rho(k))/N arrays without an
+   additional FFT.  The charge-background cross term is included explicitly.
+------------------------------------------------------------------------- */
+
+template <class Solver> void QMMMXTBPPPMHelper<Solver>::prepare_fused_full_solve(Solver &solver)
+{
+  if (solver.fused_full_prepared_ || solver.fused_full_pending_)
+    solver.error->all(FLERR, "Previous fused fix qmmm/xtb KSpace solve was not consumed");
+  if (solver.fused_mm_work1_.size() != static_cast<std::size_t>(2) * solver.nfft ||
+      solver.fused_mm_field_.size() != static_cast<std::size_t>(3) * solver.ngrid)
+    solver.error->all(FLERR, "Missing MM reference for fused fix qmmm/xtb KSpace solve");
+
+  double cross_energy_local = 0.0;
+  std::array<double, 6> cross_virial_local{};
+  for (int i = 0, n = 0; i < solver.nfft; ++i, n += 2) {
+    if (solver.greensfn[i] == 0.0) continue;
+    const double product = (solver.fused_mm_work1_[n] * solver.work1[n] +
+                            solver.fused_mm_work1_[n + 1] * solver.work1[n + 1]) /
+        solver.greensfn[i];
+    cross_energy_local += product;
+    for (int j = 0; j < 6; ++j) cross_virial_local[j] += product * solver.vg[i][j];
+  }
+
+  double cross_energy = 0.0;
+  std::array<double, 6> cross_virial{};
+  MPI_Allreduce(&cross_energy_local, &cross_energy, 1, MPI_DOUBLE, MPI_SUM, solver.world);
+  MPI_Allreduce(cross_virial_local.data(), cross_virial.data(), 6, MPI_DOUBLE, MPI_SUM,
+                solver.world);
+
+  const double qscale = solver.qqrd2e * solver.scale;
+  cross_energy *= solver.volume * qscale;
+  cross_energy -= 2.0 * MY_PI2 * solver.fused_mm_qsum_ * solver.qsum /
+      (solver.g_ewald * solver.g_ewald * solver.volume) * qscale;
+  solver.fused_full_energy_ = solver.fused_mm_energy_ + solver.energy + cross_energy;
+  for (int i = 0; i < 6; ++i)
+    solver.fused_full_virial_[i] =
+        solver.fused_mm_virial_[i] + solver.virial[i] + solver.volume * qscale * cross_virial[i];
+
+  FFT_SCALAR *field[3] = {&(solver.vdx_brick[solver.nzlo_out][solver.nylo_out][solver.nxlo_out]),
+                          &(solver.vdy_brick[solver.nzlo_out][solver.nylo_out][solver.nxlo_out]),
+                          &(solver.vdz_brick[solver.nzlo_out][solver.nylo_out][solver.nxlo_out])};
+  for (int dim = 0; dim < 3; ++dim)
+    for (int i = 0; i < solver.ngrid; ++i)
+      field[dim][i] += solver.fused_mm_field_[static_cast<std::size_t>(dim) * solver.ngrid + i];
+
+  solver.fused_full_prepared_ = true;
+}
+
+/* ----------------------------------------------------------------------
+   publish a successfully prepared field for one exact production phase
+------------------------------------------------------------------------- */
+
+template <class Solver>
+void QMMMXTBPPPMHelper<Solver>::commit_fused_full_solve(Solver &solver, bigint timestep,
+                                                        int vflag, int whichflag, int setupflag)
+{
+  if (!solver.fused_full_prepared_ || solver.fused_full_pending_)
+    solver.error->all(FLERR, "Cannot commit an unprepared fused fix qmmm/xtb KSpace solve");
+  if (whichflag != 1 && whichflag != 2)
+    solver.error->all(FLERR, "Fused fix qmmm/xtb KSpace commit requires run or minimize phase");
+
+  solver.fused_full_timestep_ = timestep;
+  solver.fused_full_vflag_ = vflag;
+  solver.fused_full_whichflag_ = whichflag;
+  solver.fused_full_setupflag_ = setupflag;
+  solver.fused_full_prepared_ = false;
+  solver.fused_full_pending_ = true;
+}
+
+/* ----------------------------------------------------------------------
+   abandon a prepared field after the surrounding fix transaction fails
+
+   prepare_fused_full_solve() has already added the cached MM field in place.
+   Clearing only the pending bit is sufficient: the next production compute
+   takes the complete base PPPM path, whose poisson_ik() overwrites every owned
+   field element before forward grid communication reconstructs ghost values.
+   This rollback must remain allocation-free, collective-free, and noexcept.
+------------------------------------------------------------------------- */
+
+template <class Solver>
+void QMMMXTBPPPMHelper<Solver>::discard_fused_full_solve(Solver &solver) noexcept
+{
+  solver.fused_full_prepared_ = false;
+  solver.fused_full_pending_ = false;
+}
+
+/* ----------------------------------------------------------------------
+   satisfy the next production KSpace call from the preassembled full field
+------------------------------------------------------------------------- */
+
+template <class Solver>
+bool QMMMXTBPPPMHelper<Solver>::compute_fused_full_if_pending(Solver &solver, int eflag, int vflag)
+{
+  if (!solver.fused_full_pending_) {
+    if (solver.fused_full_prepared_)
+      solver.error->all(FLERR, "Uncommitted fused fix qmmm/xtb KSpace field reached compute");
+    return false;
+  }
+
+  if (solver.update->ntimestep != solver.fused_full_timestep_ ||
+      vflag != solver.fused_full_vflag_ ||
+      solver.update->whichflag != solver.fused_full_whichflag_ ||
+      solver.update->setupflag != solver.fused_full_setupflag_) {
+    discard_fused_full_solve(solver);
+    solver.error->all(FLERR, "Fused fix qmmm/xtb KSpace solve reached an unexpected phase");
+  }
+
+  // Consume the token before any operation that can throw. If publication
+  // fails, the next compute performs a complete base PPPM overwrite.
+  solver.fused_full_pending_ = false;
+
+  solver.ev_init(eflag, vflag);
+  if (solver.evflag_atom)
+    solver.error->all(FLERR, "Fused fix qmmm/xtb KSpace does not support per-atom KSpace output");
+
+  // fix qmmm/xtb reads the global energy every step, including steps on which
+  // the outer integrator did not request an energy or virial tally.
+  solver.energy = solver.fused_full_energy_;
+  for (int i = 0; i < 6; ++i) solver.virial[i] = solver.fused_full_virial_[i];
+
+  if (solver.triclinic == 0)
+    solver.boxlo = solver.domain->boxlo;
+  else {
+    solver.boxlo = solver.domain->boxlo_lamda;
+    solver.domain->x2lamda(solver.atom->nlocal);
+  }
+  solver.fieldforce();
+  if (solver.triclinic) solver.domain->lamda2x(solver.atom->nlocal);
+
+  return true;
+}
