# Test-only same-instance transaction recovery. The command performs an
# initial KSpace-compute-no rejection/retry, a post-prepare failure/retry, and
# an abandoned post-commit token followed by a same-instance retry.

plugin load ${dprc_plugin}
units real
atom_style charge
atom_modify map array
boundary p p p
region cell block 0 20 0 20 0 20 units box
create_box 3 cell
create_atoms 1 single 9.60 10.0 10.0 units box
create_atoms 1 single 10.40 10.0 10.0 units box
create_atoms 2 single 5.00 10.0 10.0 units box
create_atoms 3 single 15.00 10.0 10.0 units box
mass 1 1.008
mass 2 22.990
mass 3 35.450
set atom 1*2 charge 0.0
set atom 3 charge 1.0
set atom 4 charge -1.0
group qm id 1 2
pair_style coul/long 8.0
pair_coeff * *
kspace_style pppm/dprc 1.0e-5
fix qmmm qm qmmm/xtb/dprc elements H Na Cl cutoff 8.0 method gfn2 &
    charge 0 uhf 0 accuracy 1.0e-3 maxiter 250 etemp 300.0 mmhardness 0.0
thermo 1
thermo_style custom step pe f_qmmm
run 0 post no
dprc/test/qmmm_failure_recovery qmmm
