# A charged MM site starts outside the physical QM cutoff but inside the
# cutoff+skin superset, then crosses the cutoff without a neighbor rebuild.
# The private path must match the strict-cutoff libxTB reference while keeping
# one xTBloom plan and using WARM on the second force evaluation.

plugin load ${dprc_plugin}

units           real
atom_style      charge
atom_modify     map array
boundary        p p p

region          cell block 0 40 0 40 0 40 units box
create_box      3 cell
create_atoms    1 single 19.60 20.0 20.0 units box
create_atoms    1 single 20.40 20.0 20.0 units box
create_atoms    2 single 15.00 20.0 20.0 units box
create_atoms    3 single 25.00 20.0 20.0 units box
create_atoms    2 single 29.00 20.0 20.0 units box

mass            1 1.008
mass            2 22.990
mass            3 35.450
set             atom 1 charge 0.0
set             atom 2 charge 0.0
set             atom 3 charge 1.0
set             atom 4 charge -1.0
set             atom 5 charge 0.25
group           qm id 1 2
group           crossing id 5

pair_style      coul/long 8.0
pair_coeff      * *
kspace_style    ${kspace_style} 1.0e-5
fix             qmmm qm ${qmmm_style} elements H Na Cl cutoff 8.0 &
                method gfn2 charge 0 uhf 0 accuracy 1.0e-3 maxiter 250 &
                etemp 300.0 mmhardness 0.0

# Keep one neighbor epoch while atom 5 moves from 8.6 to 7.6 Angstrom from
# the nearest QM atom. The strict reference changes its point list; the DPRC
# path changes only the stable slot's charge from exactly zero to +0.25.
neighbor        2.0 nsq
neigh_modify    every 100 delay 100 check no
fix             mover crossing move linear -1.0 0.0 0.0 units box

variable        q1 equal q[1]
variable        q2 equal q[2]
variable        fx1 equal fx[1]
variable        fy1 equal fy[1]
variable        fz1 equal fz[1]
variable        fx2 equal fx[2]
variable        fy2 equal fy[2]
variable        fz2 equal fz[2]
variable        fx3 equal fx[3]
variable        fy3 equal fy[3]
variable        fz3 equal fz[3]
variable        fx4 equal fx[4]
variable        fy4 equal fy[4]
variable        fz4 equal fz[4]
variable        fx5 equal fx[5]
variable        fy5 equal fy[5]
variable        fz5 equal fz[5]
compute         config_pressure all pressure NULL virial
thermo          1
thermo_style    custom step pe f_qmmm v_q1 v_q2 v_fx1 v_fy1 v_fz1 &
                v_fx2 v_fy2 v_fz2 v_fx3 v_fy3 v_fz3 &
                v_fx4 v_fy4 v_fz4 v_fx5 v_fy5 v_fz5 &
                c_config_pressure[1] c_config_pressure[2] &
                c_config_pressure[3] c_config_pressure[4] &
                c_config_pressure[5] c_config_pressure[6]
run             1

print "energy=$(pe:%.16e) correction=$(f_qmmm:%.16e) q1=$(v_q1:%.16e) q2=$(v_q2:%.16e) fx1=$(v_fx1:%.16e) fy1=$(v_fy1:%.16e) fz1=$(v_fz1:%.16e) fx2=$(v_fx2:%.16e) fy2=$(v_fy2:%.16e) fz2=$(v_fz2:%.16e) fx3=$(v_fx3:%.16e) fy3=$(v_fy3:%.16e) fz3=$(v_fz3:%.16e) fx4=$(v_fx4:%.16e) fy4=$(v_fy4:%.16e) fz4=$(v_fz4:%.16e) fx5=$(v_fx5:%.16e) fy5=$(v_fy5:%.16e) fz5=$(v_fz5:%.16e) pxx=$(c_config_pressure[1]:%.16e) pyy=$(c_config_pressure[2]:%.16e) pzz=$(c_config_pressure[3]:%.16e) pxy=$(c_config_pressure[4]:%.16e) pxz=$(c_config_pressure[5]:%.16e) pyz=$(c_config_pressure[6]:%.16e)" file ${result_file} screen no

unfix           qmmm
