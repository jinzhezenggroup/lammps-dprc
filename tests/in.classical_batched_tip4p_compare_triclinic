# Independent MM-only comparison for the shared batched LJ/TIP4P/PPPM path.

plugin load ${dprc_plugin}

units           real
atom_style      full
atom_modify     map array
boundary        p p p

region          cell prism 0 20 0 18.8561808316 0 16.3299316186 &
                -6.6666666667 -6.6666666667 -9.4280904158 units box
create_box      2 cell bond/types 1 angle/types 1 extra/bond/per/atom 2 &
                extra/angle/per/atom 1 extra/special/per/atom 2

# TIP4P topology requires each oxygen to be followed by its two hydrogens.
create_atoms    1 single -2.6666667 4.7140452 8.1649658 units box
create_atoms    2 single -1.7094667 4.7140452 8.1649658 units box
create_atoms    2 single -2.9066539 5.6406724 8.1649658 units box
create_atoms    1 single 5.4000000 9.1000000 4.6000000 units box
create_atoms    2 single 6.2870000 9.4100000 4.4100000 units box
create_atoms    2 single 5.0880000 9.9820000 4.4480000 units box

mass            1 15.999
mass            2 1.008
set             type 1 charge -1.040
set             type 2 charge 0.520
set             atom 1*3 mol 1
set             atom 4*6 mol 2

create_bonds    single/bond 1 1 2
create_bonds    single/bond 1 1 3
create_bonds    single/angle 1 2 1 3
create_bonds    single/bond 1 4 5
create_bonds    single/bond 1 4 6
create_bonds    single/angle 1 5 4 6
bond_style      harmonic
bond_coeff      1 450.0 0.9572
angle_style     harmonic
angle_coeff     1 55.0 104.52

pair_style      hybrid/overlay ${lj_style} 8.0 &
                ${coulomb_style} 1 2 1 1 0.1546 8.0
pair_coeff      * * ${lj_style} 0.0 1.0
pair_coeff      1 1 ${lj_style} 0.1521 3.1507
pair_coeff      1*2 1*2 ${coulomb_style}
pair_modify     pair ${lj_style} tail yes
special_bonds   amber
kspace_style    ${kspace_style} 1.0e-6
kspace_modify   mesh 16 16 16 order 4 gewald 0.30
if              "${use_batched_classical} == 1" then &
                "fix classical all dprc/classical/batch"

variable        fx1 equal fx[1]
variable        fy1 equal fy[1]
variable        fz1 equal fz[1]
variable        fx2 equal fx[2]
variable        fy2 equal fy[2]
variable        fz2 equal fz[2]
variable        fx3 equal fx[3]
variable        fy3 equal fy[3]
variable        fz3 equal fz[3]
variable        fx4 equal fx[4]
variable        fy4 equal fy[4]
variable        fz4 equal fz[4]
variable        fx5 equal fx[5]
variable        fy5 equal fy[5]
variable        fz5 equal fz[5]
variable        fx6 equal fx[6]
variable        fy6 equal fy[6]
variable        fz6 equal fz[6]
compute         config_pressure all pressure NULL virial
thermo          1
thermo_style    custom step pe evdwl ecoul elong v_fx1 v_fy1 v_fz1 &
                v_fx2 v_fy2 v_fz2 v_fx3 v_fy3 v_fz3 &
                v_fx4 v_fy4 v_fz4 v_fx5 v_fy5 v_fz5 &
                v_fx6 v_fy6 v_fz6 c_config_pressure[1] &
                c_config_pressure[2] c_config_pressure[3] &
                c_config_pressure[4] c_config_pressure[5] &
                c_config_pressure[6]
run             0

print "energy=$(pe:%.16e) evdwl=$(evdwl:%.16e) ecoul=$(ecoul:%.16e) elong=$(elong:%.16e) fx1=$(v_fx1:%.16e) fy1=$(v_fy1:%.16e) fz1=$(v_fz1:%.16e) fx2=$(v_fx2:%.16e) fy2=$(v_fy2:%.16e) fz2=$(v_fz2:%.16e) fx3=$(v_fx3:%.16e) fy3=$(v_fy3:%.16e) fz3=$(v_fz3:%.16e) fx4=$(v_fx4:%.16e) fy4=$(v_fy4:%.16e) fz4=$(v_fz4:%.16e) fx5=$(v_fx5:%.16e) fy5=$(v_fy5:%.16e) fz5=$(v_fz5:%.16e) fx6=$(v_fx6:%.16e) fy6=$(v_fy6:%.16e) fz6=$(v_fz6:%.16e) pxx=$(c_config_pressure[1]:%.16e) pyy=$(c_config_pressure[2]:%.16e) pzz=$(c_config_pressure[3]:%.16e) pxy=$(c_config_pressure[4]:%.16e) pxz=$(c_config_pressure[5]:%.16e) pyz=$(c_config_pressure[6]:%.16e)" file ${result_file} screen no
