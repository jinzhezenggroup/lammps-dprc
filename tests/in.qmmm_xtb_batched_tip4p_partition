# Two one-rank umbrella-like windows sharing one classical CUDA and xTBloom
# owner.  The QM geometry differs between slots so a result mix-up cannot hide
# behind identical frame bytes; the focused backend test supplies the detailed
# per-slot CPU oracle comparison.

plugin load ${dprc_plugin}
variable        frame_shift world 0.0 0.17

units           real
atom_style      full
atom_modify     map array
boundary        p p p

region          cell prism 0 20 0 18.8561808316 0 16.3299316186 &
                -6.6666666667 -6.6666666667 -9.4280904158 units box
create_box      3 cell bond/types 1 angle/types 1 extra/bond/per/atom 2 &
                extra/angle/per/atom 1 extra/special/per/atom 2
create_atoms    1 single 2.9333333 4.7140452 8.1649658 units box
create_atoms    1 single 3.7333333 4.7140452 8.1649658 units box
create_atoms    2 single -2.6666667 4.7140452 8.1649658 units box
create_atoms    3 single -1.7094667 4.7140452 8.1649658 units box
create_atoms    3 single -2.9066539 5.6406724 8.1649658 units box
group           shifted_qm id 2
displace_atoms  shifted_qm move ${frame_shift} 0.0 0.0 units box

mass            1 1.008
mass            2 15.999
mass            3 1.008
set             atom 1*2 charge 0.0
set             atom 3 charge -1.040
set             atom 4*5 charge 0.520
set             atom 3*5 mol 1
group           qm id 1 2

create_bonds    single/bond 1 3 4
create_bonds    single/bond 1 3 5
create_bonds    single/angle 1 4 3 5
bond_style      harmonic
bond_coeff      1 450.0 0.9572
angle_style     harmonic
angle_coeff     1 55.0 104.52

pair_style      hybrid/overlay lj/cut/dprc/batch 8.0 &
                tip4p/long/dprc/batch 2 3 1 1 0.1546 8.0
pair_coeff      * * lj/cut/dprc/batch 0.10 0.50
pair_coeff      2*3 2*3 tip4p/long/dprc/batch
pair_modify     pair lj/cut/dprc/batch tail yes
kspace_style    pppm/tip4p/dprc/batch 1.0e-5
kspace_modify   mesh 16 16 16 order 4 gewald 0.30
fix             qmmm qm qmmm/xtb/dprc elements H O H cutoff 8.0 &
                method gfn2 charge 0 uhf 0 accuracy 1.0e-3 maxiter 250 &
                etemp 300.0 mmhardness 0.0

thermo          1
thermo_style    custom step pe f_qmmm
run             0
